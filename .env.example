# Database. Leave empty to use the embedded PGlite database in ./.data/pglite (no Docker needed).
# For Postgres: postgres://postgres:pullback@localhost:5432/postgres
DATABASE_URL=

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_BUYER_EMAIL=
# Sandbox test card from Developer Dashboard > Testing Tools > Card Generator
PAYPAL_TEST_CARD_NUMBER=
PAYPAL_TEST_CARD_EXPIRY=2030-12
PAYPAL_TEST_CARD_CVV=123

# Google Gemini (aistudio.google.com)
GEMINI_API_KEY=
LLM_MODEL_REASONING=gemini-3.1-pro-preview
LLM_MODEL_FAST=gemini-3.5-flash

APP_BASE_URL=http://localhost:3000
REFUND_CAP_PER_ORDER_USD=100
REFUND_CAP_PER_BATCH_USD=2000
DEMO_MODE=true
